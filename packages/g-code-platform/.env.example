# Node 24+; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GCODE_MASTER_KEY=REPLACE_WITH_32_RANDOM_BYTES_IN_BASE64
GCODE_DB=./data/platform.db
GCODE_HOST=127.0.0.1
GCODE_PORT=8787
GCODE_PUBLIC_ORIGIN=https://gcode.example.com
GCODE_PRODUCTION=true
# Only loopback mock upstreams may use HTTP when false; never arbitrary HTTP hosts.
GCODE_ALLOW_LOOPBACK_UPSTREAM=false
GCODE_ALLOW_REGISTRATION=true
# micro-CNY: 1000000 = CNY 1; budget is NOT a model price. Set your own daily limit.
GCODE_DAILY_COST_LIMIT_MICROS=REPLACE_WITH_YOUR_DAILY_COST_LIMIT
GCODE_USER_RPM=10
GCODE_USER_CONCURRENCY=2
GCODE_MAX_ATTEMPTS=3
GCODE_ROUTE_DEADLINE_MS=60000
# Administrator creation only; password is read from a private file, not a command argument.
GCODE_ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
GCODE_ADMIN_PASSWORD_FILE=./data/admin-password.txt

# Limit concurrent memory-hard login/registration password hashing.
GCODE_AUTH_CONCURRENCY=2
